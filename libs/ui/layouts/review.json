{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "children": [
    {
      "id": "body",
      "type": "row",
      "divider": { "width": 1, "color": "border" },
      "children": [
        {
          "id": "left",
          "type": "column",
          "size": { "weight": 1 },
          "min": 300,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": { "px": 42 },
              "window_drag": true,
              "content": { "mod": "tabs" }
            },
            {
              "id": "main",
              "type": "block",
              "padding": 8,
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": { "content": { "mod": "pane" }, "height": 30 }
                }
              }
            }
          ]
        },
        {
          "id": "review",
          "type": "column",
          "size": { "weight": 1 },
          "min": 320,
          "max": 1400,
          "background": "chrome",
          "children": [
            {
              "id": "review-head",
              "type": "block",
              "size": { "px": 42 },
              "window_drag": true,
              "content": { "mod": "review-head" }
            },
            {
              "id": "review-changes",
              "type": "block",
              "content": { "mod": "review-changes" }
            },
            {
              "id": "review-commit",
              "type": "block",
              "size": { "px": 88 },
              "content": { "mod": "review-commit" }
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": { "px": 28 },
      "content": { "mod": "workspace-status" }
    }
  ]
}
