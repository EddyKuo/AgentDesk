{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [14, 16],
  "padding": [12, 12],
  "gap": 12,
  "children": [
    {
      "id": "header",
      "type": "block",
      "size": { "px": 44 },
      "window_drag": true,
      "content": { "mod": "cockpit-header" }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 12,
      "children": [
        {
          "id": "gauges",
          "type": "block",
          "size": { "px": 240 },
          "content": { "mod": "cockpit-gauges" }
        },
        {
          "id": "center",
          "type": "column",
          "gap": 12,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": { "tab": "active", "pane": { "radius": 4, "gap": 8, "lone": true } }
            },
            {
              "id": "log",
              "type": "block",
              "size": { "px": 120 },
              "content": { "mod": "cockpit-log" }
            }
          ]
        },
        {
          "id": "roster",
          "type": "block",
          "size": { "px": 280 },
          "content": { "mod": "cockpit-roster" }
        }
      ]
    }
  ]
}
