{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [8, 7],
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": { "px": 26 },
      "window_drag": true,
      "content": { "mod": "tiling-bar" }
    },
    {
      "id": "main",
      "type": "block",
      "padding": [8, 8],
      "content": {
        "tab": "active",
        "pane": {
          "header": { "content": { "mod": "tiling-pane" }, "height": 18 },
          "border": { "width": 1, "color": "border" },
          "focus": { "width": 2, "color": "accent" },
          "radius": 0,
          "gap": 8,
          "lone": true
        }
      }
    }
  ]
}
