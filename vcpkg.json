{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "agentdesk",
  "version": "0.2.0",
  "builtin-baseline": "afa249f12f52ed8a3b919f195495ba8b330288d1",
  "dependencies": [
    "gtest",
    "nlohmann-json",
    "lunasvg",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        {
          "name": "win32-binding",
          "platform": "windows"
        },
        {
          "name": "dx11-binding",
          "platform": "windows"
        },
        {
          "name": "osx-binding",
          "platform": "osx"
        },
        {
          "name": "metal-binding",
          "platform": "osx"
        },
        "wchar32",
        "freetype"
      ]
    },
    {
      "name": "freetype",
      "default-features": false
    }
  ],
  "overrides": [
    {
      "name": "imgui",
      "version": "1.93.0"
    },
    {
      "name": "gtest",
      "version": "1.18.0"
    },
    {
      "name": "nlohmann-json",
      "version": "3.12.0"
    },
    {
      "name": "lunasvg",
      "version": "3.5.0"
    },
    {
      "name": "plutovg",
      "version": "1.3.3"
    },
    {
      "name": "freetype",
      "version": "2.15.0"
    }
  ]
}
